default_platform(:ios)

platform :ios do
  desc "Build for iOS Simulator (no signing needed)"
  lane :build_simulator do
    sh(command: "xcodegen generate", log: false)
    gym(
      project: "AltMobilePlay.xcodeproj",
      scheme: "AltPlay",
      destination: "generic/platform=iOS Simulator",
      skip_package_ipa: true,
      skip_codesigning: true,
      clean: true,
      output_name: "AltPlay"
    )
  end

  desc "Build signed IPA and upload to TestFlight (requires secrets)"
  lane :push_to_testflight do
    %w[APP_ID TEAM_ID APPLE_KEY_ID APPLE_ISSUER_ID APPLE_KEY_CONTENT MATCH_REPOSITORY].each do |key|
      UI.user_error!("Missing secret: #{key}. Add it in GitHub repo Settings → Secrets and variables → Actions.") if ENV[key].nil? || ENV[key].strip.empty?
    end

    api_key = app_store_connect_api_key(
      key_id: ENV["APPLE_KEY_ID"],
      issuer_id: ENV["APPLE_ISSUER_ID"],
      key_content: ENV["APPLE_KEY_CONTENT"],
      is_key_content_base64: true
    )

    sh(command: "xcodegen generate", log: false)

    match(
      type: "appstore",
      app_identifier: [ENV["APP_ID"]],
      git_url: ENV["MATCH_REPOSITORY"],
      api_key: api_key,
      readonly: false,
      force: false
    )

    begin
      build_num = latest_testflight_build_number(api_key: api_key)
    rescue
      build_num = 0
    end
    increment_build_number(build_number: build_num + 1)

    gym(
      scheme: "AltPlay",
      export_method: "app-store",
      output_directory: "build",
      output_name: "AltPlay"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: false,
      distribute_external: false,
      notify_external_testers: false,
      changelog: "CI build from branch #{git_branch}"
    )
  end
end
